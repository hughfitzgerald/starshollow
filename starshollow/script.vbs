        End With

        With .Timers("town_meeting_post_mode")
            .StartRunning = False
            .Direction = "down"
            .StartValue = 6
            .EndValue = 0
            .TickInterval = 1000
            With .ControlEvents()
                .EventName = "town_meeting_post_mode"
                .Action = "start"
            End With
        End With

        With .Timers("town_meeting_intro_delay")
            .StartRunning = True
            .Direction = "down"
            .StartValue = 5
            .EndValue = 0
            .TickInterval = 1000    ' Tick every 1 second (1000 ms)
            With .ControlEvents()
                .EventName = "play_voc_tm_punctuality_dirty"
                .Action = "jump"
                .Value = 5
            End With
            With .ControlEvents()
                .EventName = "play_voc_tm_gavelx3"
                .Action = "jump"
                .Value = 8
            End With
            With .ControlEvents
                .EventName = "skip_minigame_intro{device.timers.town_meeting_intro_delay.ticks > 0}"
                .Action = "jump"
                .Value = 0
            End With
