                .Add "dinner_voc_4", 1
                .Add "dinner_voc_5", 1
                .Add "dinner_voc_6", 1
                .Add "dinner_voc_7", 1
                .ForceAll = True
                .ForceDifferent = True
            End With
        End With

        For Each shot In dinner_shots
            With .Shots(shot.Name)
                .Switch = shot.Switch
                .Profile = "mode_shot_flash"
                With .Tokens()
                    .Add "lights", shot.Light
                    .Add "color", "ffff00"
                End With
                With .ControlEvents()
                    .Events = Array("mode_dinner_started")
                    .State = 1
                End With
                With .ControlEvents()
                    .Events = Array("mode_dinner_stopping")
                    .State = 0
                End With
            End With
        Next
    End With
End Sub

' Bonus Mode.

' The bonus tally, one row per line, in the order they are shown:
'     Array(name, count, title, score)
'   name   suffix of the show_bonus_<name> event posted when the line is shown
'   count  player variable; the line is skipped when it is 0
'   title  VBScript expression for the slide's text - wrap fixed text in KwargText
'   score  VBScript expression for the slide's score, or "" for current_player.<count>
'          (numeric scores are comma-formatted by DmdTick_Bonus)
' Each line gets its own GI light show; the last line gets the up-and-down sweep.
Function EobBonusLines()
    EobBonusLines = Array( _
        Array("multiplier",     "total_switches_hit",        """BONUS "" & current_player.bonus_multiplier & ""x""", "current_player.bonus_multiplier * BonusMultiplierFactor * current_player.total_switches_hit"), _
        Array("coffee",         "bumper_count",              KwargText("COFFEE COFFEE COFFEE"),  "current_player.bumper_count & "" CUPS x "" & BonusBumperFactor"), _
        Array("diners",         "diner_count",               KwargText("LUKE'S DINER"),          "current_player.diner_count & "" MEALS x "" & BonusDinerFactor"), _
        Array("grandparents",   "grandparents_count",        KwargText("GRANDPARENTS"),          "current_player.grandparents_count & "" VISITS x "" & BonusGrandparentsFactor"), _
        Array("talking",        "spinner_count",             KwargText("FAST TALKING"),          "current_player.spinner_count & "" QUIPS x "" & BonusSpinnerFactor"), _
        Array("llmb",           "mode_llmb_score",           KwargText("LOCK-AWAY LOGAN"),       ""), _
        Array("jdmb",           "mode_jdmb_score",           KwargText("JESS & DEAN: TO THE DEATH"), ""), _
        Array("dm",             "mode_dance_marathon_score", KwargText("DANCE MARATHON"),        ""), _
        Array("tm",             "mode_town_meeting_score",   KwargText("TOWN MEETING"),          ""), _
        Array("lbtb",           "mode_lbtb_score",           KwargText("LUKE BREAKS THE BELLS"), ""), _
        Array("kims_antiques",  "mode_kims_antiques_score",  KwargText("KIM'S ANTIQUES"),        ""), _
        Array("dinner",         "mode_dinner_score",         KwargText("FRIDAY NIGHT DINNER"),   ""), _
        Array("fd_punch",       "mode_fd_punch_score",       KwargText("FOUNDER'S DAY PUNCH"),   ""), _
        Array("total",          "bonus_total",               KwargText("TOTAL BONUS"),           "") _
    )
End Function

Sub CreateBonusMode
    Dim x, row, score
    Dim bonusLines : bonusLines = EobBonusLines()
    Dim bonusShows : bonusShows = UBound(bonusLines) + 1
    With CreateGlfMode("eob_bonus", 150)
        .StartEvents = Array("ball_ending{game.tilted == False}")
        .StopEvents = Array("bonus_finished")
        .UseWaitQueue = True
        .Debug = True

        With .EventPlayer()
            .Debug = True
            .Add "mode_eob_bonus_started", Array("run_bonus_started", "gi_lights_off")

            .Add "run_bonus_started", Array("calculate_bonus_total", "play_bonus_show1")
            .Add "calculate_bonus_total", Array("add_bonus_total_to_score")
            'bonus_total is set by the variable player on calculate_bonus_total, so read it one event later
            .Add "add_bonus_total_to_score", Array(ScoreEventExpr("current_player.bonus_total", NoMultiplier))

            'Show each bonus line in turn, skipping those with nothing to show. Each one
            'plays the eob_bonus slide with its text and score as kwargs, and the light
            'show it starts moves on to the next line when it completes.
            For x = 1 To bonusShows
                row = bonusLines(x - 1)
                score = row(3)
                If score = "" Then score = "current_player." & row(1)
                .Add "play_bonus_show" & x & "{current_player." & row(1) & " > 0 && current_player.bonus_skip == 0}", Array("bonus_light" & x & "_show", "do_sfx_bonus", "show_bonus_" & row(0))
                .Add "play_bonus_show" & x & "{current_player." & row(1) & " == 0 && current_player.bonus_skip == 0}", Array("play_bonus_show" & (x + 1))
                .Add "show_bonus_" & row(0), Array("show_bonus_slide:{text:" & row(2) & ",score:" & score & "}")
            Next
            .Add "play_bonus_show" & (bonusShows + 1), Array("bonus_finished")
            .Add "timer_bonus_skip_complete", Array("bonus_finished")

            .Add "do_sfx_bonus", Array("stop_sfx_eob_bonus") 'first stop the sfx if it is already playing
            .Add "stop_sfx_eob_bonus", Array("play_sfx_eob_bonus") 'then play the sfx
        End With

        With .SoundPlayer()
            With .EventName("play_sfx_eob_bonus")
                .Key = "key_sfx_eob_bonus"
                .Sound = "sfx_eob_bonus"
            End With
            With .EventName("stop_sfx_eob_bonus")
                .Key = "key_sfx_eob_bonus"
                .Sound = "sfx_eob_bonus"
                .Action = "stop"
            End With
            With .EventName("show_bonus_total")
                .Key = "key_show_bonus_total"
                .Sound = "voc_isthatgood"
            End With
        End With

        'Skip the bonus tally animations
        With .ComboSwitches("bonus_skip")
            .Switch1 = "s_left_flipper"
            .Switch2 = "s_right_flipper"
            .EventsWhenBoth = Array("skip_bonus_tally")
            '.HoldTime = 200
        End With
        
        With .Timers("bonus_skip")
            .TickInterval = 1200
            .StartValue = 0
            .EndValue = 1
            With .ControlEvents()
                .EventName = "skip_bonus_tally"
                .Action = "restart"
            End With
        End With

        With .ShowPlayer()
            For x = 1 To bonusShows - 1
                With .EventName("bonus_light"&x&"_show")
                    .Key = "key_bonus_light"&x&"_show"
                    .Show = "psc_eob_sweep"
                    .Loops = 0
                    .Priority = 2000
                    'When the show ends, move to the next one
                    .EventsWhenCompleted = Array("play_bonus_show"&(x+1))
                    With .Tokens()
                        .Add "lights", "GI"
                        .Add "color", GIColorAttract
                    End With
                End With
            Next
            With .EventName("bonus_light"&bonusShows&"_show")
                .Key = "key_bonus_light"&bonusShows&"_show"
                .Show = "psc_eob_sweep_up_and_down"
                .Loops = 0
                .Priority = 2000
                .EventsWhenCompleted = Array("play_bonus_show"&(bonusShows+1))
                With .Tokens()
                    .Add "lights", "GI"
                    .Add "color", GIColorAttract
                End With
            End With
        End With

        With .VariablePlayer()
            With .EventName("run_bonus_started")
				With .Variable("bonus_skip")
                    .Action = "set"
					.Int = 0
				End With
            End With
            With .EventName("calculate_bonus_total")
                With .Variable("bonus_total")
                    .Action = "add"
                    .Int = "{current_player.bonus_multiplier * " & BonusMultiplierFactor & _
                        " * current_player.total_switches_hit + current_player.bumper_count * " & BonusBumperFactor & _
                        " + current_player.diner_count * " & BonusDinerFactor & _
                        " + current_player.grandparents_count * " & BonusGrandparentsFactor & _
                        " + current_player.spinner_count * " & BonusSpinnerFactor & ":,}"
                End With
            End With
            With .EventName("skip_bonus_tally")
                'Skip the bonus tally
				With .Variable("bonus_skip")
                    .Action = "set"
					.Int = 1
				End With
            End With
        End With

        With .SoundPlayer()
            With .EventName("mode_eob_bonus_started")
                .Key = "key_mus_shoo"
                .Sound = "mus_shoo"
            End With
            With .EventName("mode_eob_bonus_stopped")
                .Key = "key_mus_shoo"
                .Sound = "mus_shoo"
                .Action = "stop"
            End With
        End With

        With .SlidePlayer()
            With .EventName("show_bonus_slide")
                .Slide = "eob_bonus"
                .Action = "play"
            End With
        End With
    End With
End Sub


' Extra Ball Mode
'
'  - This mode handles adding and using extra balls
'  - When "eb_now_lit" event is dispatched, and there are still EBs available to collect, then light the EB target
'  - When EB target is lit and hit, then collect the EB


Const MaxEBs = 3
Const EBShowLength = 3000


Sub CreateExtraBallMode()
    Dim x

    With CreateGlfMode("extra_ball", 510)

        'Define the events that start and stop this mode
        .StartEvents = Array("ball_started")
        .StopEvents = Array("mode_base_stopping") 
        

        'The event player will respond to events during this mode
        With .EventPlayer()

            'initialize the EB shoot again light
            .Add "mode_extra_ball_started", Array("check_eb")
            .Add "check_eb{current_player.extra_balls == 0}", Array("eb_reset")
            .Add "check_eb{current_player.extra_balls > 0}", Array("eb_lit")

            'handle successful eb collection
            .Add "s_complete_right_ramp_active{current_player.shot_eb_ready == 1}", Array("play_eb_show","eb_achieved",ScoreEvent(ExtraBallScore, WithMultiplier)) 

            'handle callouts
            ' .Add "eb_now_lit{current_player.extra_ball_eb_awarded < "&MaxEBs&"}", Array("play_voc_extra_ball_is_ready") 
            ' .Add "eb_achieved", Array("play_voc_extra_ball") 

        End With


        '--- DMD ---------------------------------------------------------
        ' Names map to FlexDMD overlays in FlexDmd_ShowWidget (ZFBC).
        ' Both fire unconditionally, as the listeners they replace did -
        ' note that eb_now_lit is dispatched even once MaxEBs have been
        ' collected, when the shot below no longer lights. Add the same
        ' {current_player.extra_ball_eb_awarded < MaxEBs} condition to the
        ' event name if you want the text to follow the light.
        With .WidgetPlayer()
            With .EventName("eb_now_lit")
                .Widget = "extra_ball_lit"
                .Action = "play"
                .Expire = 1.3
            End With
            With .EventName("eb_achieved")
                .Widget = "extra_ball"
                .Action = "play"
                .Expire = 1.3
            End With
        End With


        'Configure the extra ball award
        With .ExtraBalls("eb")
            .AwardEvents = Array("eb_achieved")
            .MaxPerGame = MaxEBs
        End With
   
        'Define the shot that awards the extra ball
        With .Shots("eb_ready")
            .Profile = "eb_ready"  'defined below
            'Light the extra ball ready shot if there are still more EBs available
            With .ControlEvents()
                .Events = Array("eb_now_lit{current_player.extra_ball_eb_awarded < "&MaxEBs&"}")
                .State = 1
            End With
            'Reset the extra ball ready shot after EB has been achieved
            .RestartEvents = Array("eb_achieved")
        End With

        'Define EB ready shot profile with two states (0 = unlit, 1 = ready)
        With .ShotProfiles("eb_ready")
            With .States("unlit")
                .Show = "off"
                .Key = "key_eb_ready_unlit"
                With .Tokens()
                    .Add "lights", "l56"
                End With
            End With
            With .States("ready")
                .Show = "led_color"
                .Key = "key_eb_ready"
                .Speed = 10
                With .Tokens()
                    .Add "lights", "l56"
                    .Add "color", ExtraBallColor
                End With
            End With
        End With


        'Define the shot that is lit when EB has been achieved
        With .Shots("eb_shoot_again")
            .Profile = "eb_shoot_again"   'defined below
            'Light the shoot again light once EB has been achieved, or when being initialized as lit
            With .ControlEvents()
                .Events = Array("eb_achieved","eb_lit")
                .State = 1
            End With
            'Reset the shoot again light when there is no more EBs left
            .RestartEvents = Array("eb_reset")
        End With


        'Define EB shoot again light profile with two states (0 = unlit, 1 = lit)
        With .ShotProfiles("eb_shoot_again")
            With .States("unlit")
                .Show = "off"
                .Key = "key_eb_unlit"
                With .Tokens()
                    .Add "lights", "l1"
                End With
            End With
            With .States("lit")
                .Show = "led_color"     'defined in glf
                .Key = "key_eb_lit"
                .Priority = 1000
                With .Tokens()
                    .Add "lights", "l1"
                    .Add "color", ExtraBallColor
                End With
            End With
        End With

        
        ' With .SegmentDisplayPlayer()
        '     With .EventName("play_eb_show")
        '         With .Display("player1")
        '             .Text = ""
        '             .Expire = EBShowLength
        '         End With
        '         With .Display("player2")
        '             .Text = " EXTRA "
        '             .Flashing = "all"
        '             .Expire = EBShowLength
        '         End With
        '         With .Display("player3")
        '             .Text = " BALL "
        '             .Flashing = "all"
        '             .Expire = EBShowLength
        '         End With
        '         With .Display("player4")
        '             .Text = ""
        '             .Expire = EBShowLength
        '         End With
        '     End With
        ' End With


    End With

End Sub
