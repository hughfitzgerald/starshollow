    With CreateDmdWidget("jess_wins")            : .Text = "TEAM JESS WINS"          : End With
    With CreateDmdWidget("dean_wins")            : .Text = "TEAM DEAN WINS"          : End With

    ' Multiplayer: whose turn it is, and a player joining mid ball 1
    For x = 1 To 4
