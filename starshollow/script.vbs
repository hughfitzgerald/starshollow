                .Action = "restart"
            End With
            With .ControlEvents()
                .EventName = "base_music_start_at_new_duration"
                .Action = "start"
            End With
            For Each bm in baseMusicArray
                With .ControlEvents()
                    .EventName = bm.Name & "_start"
                    .Action = "jump"
                    .Value = bm.Duration
                End With
            Next
