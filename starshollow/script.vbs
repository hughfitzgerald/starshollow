' Function Glf_ReplaceModeAttributes(inputString)
'     Dim pattern, replacement, regex, outputString
'     pattern = "modes\.([a-zA-Z0-9_]+)\.([a-zA-Z0-9_]+)"
'     Set regex = New RegExp
'     regex.Pattern = pattern
'     regex.IgnoreCase = True
'     regex.Global = True
