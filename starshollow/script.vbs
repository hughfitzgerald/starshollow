Class BaseMusic
    Public Name
    Public Duration
End Class

Function CreateBaseMusic(name, duration)
    Dim bm
    Set bm = New BaseMusic
    bm.Name = name
    bm.Duration = duration
    Set CreateBaseMusic = bm
End Function

